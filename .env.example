# 复制为 .env 并填写真实值（勿提交 .env）

# === 必填 ===
DASHSCOPE_API_KEY=

# === 数据库（二选一）===
# SQLALCHEMY_DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/rag_db
# 或分段：
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# === CORS（生产请改为实际前端域名）===
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true
LOG_CONFIG_AT_STARTUP=true

# === Redis（记忆总线、会话 token 预算、A2A TaskStore）===
REDIS_URL=redis://localhost:6379/0

# === 记忆压缩（异步史官）===
# 会话累计 token 达阈值触发固化；0=仅按轮数触发
CONSOLIDATION_SESSION_TOKEN_THRESHOLD=0

# 事务 Outbox：聊天消息、Session Event 与固化任务同事务提交；Worker 使用租约重试
MEMORY_OUTBOX_POLL_SECONDS=1.0
MEMORY_OUTBOX_LEASE_SECONDS=180
MEMORY_OUTBOX_MAX_ATTEMPTS=5

# === Tool Harness（Cordis 风格工具编排）桥接 ===
# 开启后已迁移工具优先走 tool_harness 执行，失败自动降级回旧注册表
TOOL_HARNESS_ENABLED=false

# === 论文项目持久化 ===
# json（默认，本地文件）| db（MySQL paper_projects 表）
PAPER_STORE_BACKEND=json

# === A2A Task 存储 ===
# memory（默认）| redis
A2A_TASK_STORE_BACKEND=memory

# === 论文写作栈 ===
PAPER_USE_A2A_STACK=true

# === 统一检索入口（app/rag_service.py） ===
# 检索默认臂：vector（默认，消融显示等权 RRF hybrid 劣于纯向量）| hybrid
RAG_RETRIEVAL_MODE=vector
# 统一返回 Top-N
RAG_TOP_N=5
# 单条证据片段最大字符数（0 = 不截断）
RAG_HIT_MAX_CHARS=4000
# child chunk 是否注入上下文头（[论文标题 | section] 前缀）
RAG_CHILD_CONTEXT_HEADER=true
# child chunk 目标字符数
RAG_CHILD_CHUNK_SIZE=400
# parent（section）块软上限：超过时按段落边界溢出切分
RAG_PARENT_SOFT_MAX_CHARS=3500

# === 独立 RAG MCP Server（rag_mcp_server.py） ===
# stdio（默认）| sse | streamable-http
RAG_MCP_TRANSPORT=stdio

# === RAG 检索模式与 FTS 分层 ===
# auto（默认：向量可用走 vector，embedding 不可达降级全文检索）| vector | hybrid | fts
RAG_RETRIEVAL_MODE=auto
# FTS 全文索引文件（SQLite FTS5 投影；默认数据目录根 rag_fts.db）
RAG_FTS_PATH=

# === 独立 Memory MCP Server（memory_mcp_server.py → app/memory_mcp_server.py） ===
# stdio（默认）；依赖 SQLALCHEMY_DATABASE_URL（agent_memory 真源）与 Chroma 目录
MEMORY_MCP_TRANSPORT=stdio
# 外接宿主（codex 等）不传 username 时的默认用户名
MEMORY_MCP_DEFAULT_USERNAME=codex

# === RAG v2 升级层（默认全关，各自独立成消融臂） ===
# GROBID 学术 PDF 结构化解析（Docker: docker run --rm -p 8070:8070 lfoppiano/grobid:0.8.0）
# PDF_PARSER_MODE=grobid 时优先 GROBID，不可达自动回退 layout
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SECONDS=120

# Rerank provider：dashscope（默认）| local（A800 本地服务）| off（消融基线）
# local 服务启动：python scripts/run_local_rerank_server.py --model BAAI/bge-reranker-v2-m3
RERANK_PROVIDER=dashscope
RERANK_LOCAL_URL=http://localhost:8081
RERANK_LOCAL_TIMEOUT_SECONDS=10
# 统一入口 rag_search 是否检索后追加 rerank（graph 节点路径不受影响）
RAG_RERANK_ENABLED=false

# Contextual Retrieval（入库时 LLM 为 child 生成情境说明，Anthropic 2024）
# 成本：每 child 一次 LLM 调用；模型为空时复用 app.chains.llm
RAG_CONTEXTUAL_ENABLED=false
RAG_CONTEXTUAL_MODEL=
RAG_CONTEXTUAL_MAX_CHARS=300

# VLM 图表描述（figure 文本代理；需 dashscope SDK）
RAG_VLM_ENABLED=false
RAG_VLM_MODEL=qwen-vl-max
