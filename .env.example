# Paper-Context 环境配置示例
# 全部可选项：FTS 全文检索零配置可用（无需任何 API key）；以下按需开启。

# === 核心（服务与数据） ===
SQLALCHEMY_DATABASE_URL=mysql+pymysql://root:@localhost:3306/paper_context?charset=utf8mb4
# DASHSCOPE_API_KEY=

# === 检索模式与 FTS 分层 ===
RAG_RETRIEVAL_MODE=auto
# RAG_FTS_PATH=
# RAG_TOP_N=
# RAG_HIT_MAX_CHARS=
VECTOR_BACKEND=chroma
VECTOR_COLLECTION_NAME=split_parents
# COLLECTION_REVISION_ENABLED=
# DB_DIR=
# STORE_DIR=

# === 结构化切分 ===
INGESTION_SECTION_AWARE=true
# RAG_CHILD_CHUNK_SIZE=
RAG_CHILD_CONTEXT_HEADER=true
# RAG_PARENT_SOFT_MAX_CHARS=
# PDF_PARSER_MODE=
PDF_PARSER_OCR_ENABLED=false

# === 检索可选档（默认关） ===
RAG_RERANK_ENABLED=false
RERANK_PROVIDER=dashscope
# RERANK_LOCAL_URL=
# RERANK_LOCAL_TIMEOUT_SECONDS=
RAG_CONTEXTUAL_ENABLED=false
# RAG_CONTEXTUAL_MODEL=
# RAG_CONTEXTUAL_MAX_CHARS=
RAG_VLM_ENABLED=false
# RAG_VLM_MODEL=
GROBID_URL=http://localhost:8070
# GROBID_TIMEOUT_SECONDS=

# === embedding（可选） ===
# 任何 OpenAI 兼容端点（DashScope / Ollama / vLLM / 自建网关）；未配置回退 DashScope 兼容模式
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=（未配置回退 DASHSCOPE_API_KEY）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_TTL_SECONDS=
# EMBEDDING_CACHE_MAX_BYTES=

# === 记忆系统 ===
# EPISODIC_MEMORY_ENABLED=
EPISODIC_MEMORY_COLLECTION=episodic_memory
# EPISODIC_RETRIEVAL_TOP_K=
# EPISODIC_PROMPT_MAX_CHARS=
# MEMORY_GRAPH_ENABLED=
# MEMORY_GRAPH_PROMPT_MAX_CHARS=
# MEMORY_INDEX_MAX_CHARS=
# MEMORY_INDEX_MAX_ITEMS=
# MEMORY_ON_DEMAND_ENABLED=

# === MCP 服务 ===
RAG_MCP_TRANSPORT=stdio
MEMORY_MCP_TRANSPORT=stdio
MEMORY_MCP_DEFAULT_USERNAME=codex

# === Milvus（可选后端） ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=default
# MILVUS_HNSW_M=
# MILVUS_HNSW_EF_CONSTRUCTION=
# MILVUS_HNSW_EF_SEARCH=

# === 数据库（分段配置，与 SQLALCHEMY_DATABASE_URL 二选一） ===
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# === 其他（内部/高级） ===
# REDIS_URL=
# LLM_API_KEY=

# === 高级调优（模块直接读取，一般无需配置） ===
# ASYNC_INDEX_BUILD=
# CHAT_HEAVY_MIN_CHARS=
# CHAT_HISTORY_PROMPT_LIMIT=
# CHAT_PREFER_ASYNC_HEAVY=
# EMBEDDING_QUEUE_KEY=
# EMBEDDING_USE_STAGING=
# EMBEDDING_WORKER_ENABLED=
# EPISODIC_DEDUP_SIM_THRESHOLD=
# EPISODIC_MAX_CHUNKS_PER_USER=
# GLOBAL_PROFILE_SESSION_ID=
# GRADE_HEURISTIC_ENABLED=
# GRADE_MAX_PARALLEL=
# GRADE_MODE=
# GRADE_SNIPPET_CHARS=
# GRAPH_DEDUP_LOOKBACK_DAYS=
# GRAPH_MAX_TRIPLES_PER_USER=
# GRAPH_NODE_TIMING_ENABLED=
# INDEX_BUILD_QUEUE_KEY=
# LLM_BASE_URL=
# LLM_MAX_CONCURRENT=
# LLM_RATE_LIMIT_ENABLED=
# LLM_RATE_PER_SEC=
# MEMORY_INDEX_PREVIEW_CHARS=
# MEMORY_PROMOTION_CONFIRM_THRESHOLD=
# REDIS_RATE_LIMIT_ENABLED=
# REDIS_RATE_LIMIT_GLOBAL_PER_MIN=
# REDIS_RATE_LIMIT_USER_PER_MIN=
# REDIS_RATE_LIMIT_WINDOW_SEC=
# RETRIEVAL_CACHE_ENABLED=
# RETRIEVAL_CACHE_MAX_JSON_BYTES=
# RETRIEVAL_CACHE_TTL_SECONDS=
# RETRIEVE_POOL_MAX_WORKERS=
# SESSION_CACHE_MAX_JSON_BYTES=
# SESSION_CACHE_TTL_SECONDS=
# TASK_QUEUE_ENABLED=
# TASK_QUEUE_KEY=
# TASK_RESULT_PREFIX=
# TASK_WORKER_COUNT=
# USE_ASYNC_RETRIEVAL=
# USE_FAN_OUT=
# USE_PARALLEL_RETRIEVAL=
# USE_PARALLEL_TOOLS=
